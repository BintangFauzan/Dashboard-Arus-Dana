rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == 'T1NayESIKubClhwpFaotV8Z7udu2';
    }

    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /access/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'category', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time
        && (!('category' in request.resource.data)
          || (request.resource.data.category is string
            && request.resource.data.category.size() <= 80));
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /accessCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.target in ['all_users', 'selected_users']
        && request.resource.data.status in ['scheduled', 'active']
        && request.resource.data.enabled == true
        && request.resource.data.accessReconciledAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAtExclusive is timestamp
        && (
          request.resource.data.target == 'all_users'
          || request.resource.data.uids is list
          && request.resource.data.uids.size() > 0
          && request.resource.data.uids.size() <= 500
        )
      ;
      allow update, delete: if false;
    }

    match /config/{document} {
      allow read: if isAdmin() || (isSignedIn() && document in ['accessPolicy', 'trialPolicy', 'feedbackPrompts']);
      allow write: if false;
    }

    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'adminUid', 'type', 'summary', 'metadata', 'createdAt'
        ])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.type == 'create_access_campaign'
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 300
        && request.resource.data.metadata is map
        && request.resource.data.createdAt == request.time
      ;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}