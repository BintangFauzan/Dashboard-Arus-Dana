{
  "name": "arus-dana-web-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test src/campaignInput.test.js src/campaignUtils.test.js functions/test/accessPolicy.test.js",
    "test:rules": "firebase emulators:exec --project demo-arus-dana --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:emulator": "firebase emulators:exec --project demo-arus-dana --only auth,firestore,functions \"node --test functions/test/emulator.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions,pubsub",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.37.0",
    "globals": "^17.13.0",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
